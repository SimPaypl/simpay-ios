{
  "$comment": "Local validation of an order, before anything is sent. Input uses the bridge-v1 order format (amount as a decimal string). expect: 'valid' or an error code; resolvedCountryCode is the country sent as customer.countryCode. androidToday notes where Android SDK 1.0.0 (commit 00216f5) differs; such cases are known divergences until Android is aligned.",
  "base": { "amount": "49.99", "currency": "PLN", "customerEmail": "payer@example.com" },
  "cases": [
    { "name": "minimal valid order", "order": {}, "expect": "valid", "resolvedCountryCode": "PL" },
    { "name": "minimum amount", "order": { "amount": "1" }, "expect": "valid" },
    { "name": "one fractional digit", "order": { "amount": "1.5" }, "expect": "valid" },
    { "name": "large amount", "order": { "amount": "999999.99" }, "expect": "valid" },
    { "name": "below minimum", "order": { "amount": "0.99" }, "expect": "invalid_order" },
    { "name": "zero", "order": { "amount": "0" }, "expect": "invalid_order" },
    { "name": "three fractional digits", "order": { "amount": "10.125" }, "expect": "invalid_order", "androidToday": "valid (no limit on fractional digits)" },
    { "name": "negative", "order": { "amount": "-5.00" }, "expect": "invalid_order" },
    { "name": "exponent", "order": { "amount": "1e2" }, "expect": "invalid_order" },
    { "name": "comma separator", "order": { "amount": "1,50" }, "expect": "invalid_order" },
    { "name": "leading zero", "order": { "amount": "01.50" }, "expect": "invalid_order" },
    { "name": "trailing dot", "order": { "amount": "10." }, "expect": "invalid_order" },
    { "name": "whitespace", "order": { "amount": " 10.00" }, "expect": "invalid_order" },
    { "name": "amount as a JSON number", "order": { "amount": 10 }, "expect": "invalid_order" },

    { "name": "lowercase currency is normalized", "order": { "currency": "pln" }, "expect": "valid", "resolvedCountryCode": "PL" },
    { "name": "currency of two letters", "order": { "currency": "PL" }, "expect": "invalid_order", "androidToday": "valid (any non-blank text)" },
    { "name": "currency with a digit", "order": { "currency": "PL1" }, "expect": "invalid_order", "androidToday": "valid (any non-blank text)" },
    { "name": "EUR without a country", "order": { "currency": "EUR" }, "expect": "missing_country_code", "androidToday": "missing_country_code, but only when a channel is selected" },
    { "name": "EUR with a country", "order": { "currency": "EUR", "customerCountryCode": "DE" }, "expect": "valid", "resolvedCountryCode": "DE" },
    { "name": "CZK maps to a country", "order": { "currency": "CZK" }, "expect": "valid", "resolvedCountryCode": "CZ" },

    { "name": "description of 64 characters", "order": { "description": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" }, "expect": "valid" },
    { "name": "description of 65 characters", "order": { "description": "ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" }, "expect": "invalid_order" },
    { "name": "control of 255 characters", "order": { "control": "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" }, "expect": "valid" },
    { "name": "control of 256 characters", "order": { "control": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" }, "expect": "invalid_order" },
    { "name": "length counts UTF-16 units (emoji is 2)", "order": { "description": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀a" }, "expect": "invalid_order" },

    { "name": "blank e-mail", "order": { "customerEmail": "   " }, "expect": "invalid_order" },
    { "name": "missing e-mail", "order": { "customerEmail": null }, "expect": "invalid_order" },

    { "name": "lowercase country", "order": { "customerCountryCode": "pl" }, "expect": "invalid_order" },
    { "name": "alpha-3 country", "order": { "customerCountryCode": "POL" }, "expect": "invalid_order" },
    { "name": "empty country", "order": { "customerCountryCode": "" }, "expect": "invalid_order" },

    { "name": "return URLs", "order": { "returnUrls": { "success": "shopapp://simpay/return", "failure": "shopapp://simpay/return" } }, "expect": "valid" },
    { "name": "return URLs without failure", "order": { "returnUrls": { "success": "shopapp://simpay/return" } }, "expect": "invalid_order" },

    { "name": "description of wrong type", "order": { "description": 12 }, "expect": "invalid_order" }
  ]
}
