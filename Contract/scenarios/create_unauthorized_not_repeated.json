{
  "id": "create_unauthorized_not_repeated",
  "title": "Creation: HTTP 401 invalidates the session but the POST is not repeated",
  "since": "1.0.0",
  "covers": [
    "session",
    "no_unsafe_post_retry"
  ],
  "api": {
    "channels": [
      {
        "status": 200,
        "json": {
          "success": true,
          "data": [
            {
              "id": "blik-level0",
              "name": "BLIK Level 0",
              "type": "blik",
              "currencies": [
                "PLN"
              ],
              "amount": {
                "min": "1.00",
                "max": "20000.00"
              }
            },
            {
              "id": "mbank",
              "name": "mBank",
              "type": "transfer",
              "currencies": [
                "PLN"
              ],
              "amount": {
                "min": "1.00",
                "max": "50000.00"
              }
            }
          ]
        }
      }
    ],
    "create_transaction": [
      {
        "status": 401
      }
    ]
  },
  "steps": [
    {
      "action": "load_channels"
    },
    {
      "action": "select_channel",
      "channelId": "mbank"
    },
    {
      "action": "close"
    }
  ],
  "expect": {
    "result": {
      "type": "failed",
      "error": {
        "code": "unauthorized"
      }
    },
    "requests": {
      "create_transaction": 1,
      "submit_blik_code": 0
    },
    "sessionRequests": 1
  }
}
